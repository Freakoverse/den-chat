{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DEN Chat",
  "version": "0.2.0",
  "identifier": "top.denchat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "DEN Chat",
        "width": 1280,
        "height": 720,
        "minWidth": 400,
        "minHeight": 750,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
